            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"role_key\": \"job_seeker\",\n  \"name\": \"Kiran Patel\",\n  \"phone\": \"0000300001\",\n  \"email\": \"kiran.patel@example.com\",\n  \"password\": \"Secret123\",\n  \"job_category_code\": \"EDJCAT00001\"\n}",
              "options": {
                "raw": {
