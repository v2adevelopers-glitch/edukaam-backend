NODE_ENV=development
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_HOST=
DB_PORT=3306
# connections per app process (default 10)
DB_POOL_MAX=
JWT_SECRET_KEY=
# used only by the default-users seeder
SEED_ADMIN_PASSWORD=
# demo seeder: runs only when SEED_DEMO_DATA=true; every demo account gets SEED_DEMO_PASSWORD
SEED_DEMO_DATA=false
SEED_DEMO_PASSWORD=
# production base URL shown in Swagger (e.g. {{PROD_API_URL}})
PROD_API_URL={{PROD_API_URL}}
# uploaded resumes and logos; use an absolute path outside the deploy checkout in production
UPLOAD_DIR=
# outgoing email (password reset / verification codes); without SMTP_HOST, development prints
# messages to the server log and production refuses to send
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
# outgoing SMS: POST { to, message } to this URL (Bearer SMS_WEBHOOK_TOKEN if set)
SMS_WEBHOOK_URL=
SMS_WEBHOOK_TOKEN=
